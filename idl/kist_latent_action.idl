// Latent-action DDS contract between kist-vla-inference (publisher) and
// kist-gearsonic-inference (subscriber). Follows the kist-ext-sensor-io
// custom-type conventions (module kist_msgs, seq / stamp_ns fields,
// CycloneDDS idlc codegen: `idlc -l cxx` for C++, mirrored as IdlStruct
// dataclasses in kist_vla/io/dds.py for Python — keep the two in sync).
//
// Topics (rt/kist/* per the ext-sensor-io convention; authoritative
// constants: kist_vla/io/dds.py and gearsonic include/vla/vla_latent_action.hpp):
//   "rt/kist/latent_action"  LatentActionStep, Reliable + KeepLast(1), 50 Hz
//   "rt/kist/wbc_command"    WbcCommand,       Reliable + KeepLast(8)
//
// Reader behavior (gearsonic side, whole_body_controller.cpp): staleness is
// checked against the receive clock — a token fresher than 200 ms claims the
// robot for VLA; once claimed, a stream stale for 500 ms is LOST and ends
// the session: the controller blends to a safe standing token, reseeds its
// planner, and returns to the origin (robot standing, locomotion disarmed).
// A resumed stream re-claims from there — no restart needed — but do NOT
// pause mid-session expecting to keep the session: keep publishing (repeat
// the last step or the standing token) for any intentional hold.

module kist_msgs {

    // One playback step of the VLA action chunk, published at the control
    // rate (50 Hz). token_state is the SONIC latent motion token; hand
    // joints are in Dex motor order (thumb x3, index x2, middle x2) —
    // identical semantics to the ZMQ latent protocol v4 fields.
    struct LatentActionStep {
        unsigned long long seq;         // publisher-wide monotonic counter
        long long          stamp_ns;    // publish clock (epoch ns)
        long long          frame_index; // playback frame counter (resets on initial pose)
        float              token_state[64];
        float              left_hand_joints[7];
        float              right_hand_joints[7];
    };

    // Control-loop lifecycle command (mirrors the ZMQ "command" topic).
    // RESERVED for the future Orchestrator — gearsonic has no subscriber
    // yet: session lifecycle currently rides the data plane (auto-start;
    // stop publishing -> standing hold; VR e-stop -> damping). Kept in the
    // contract so the wire shape is settled before the Orchestrator lands.
    struct WbcCommand {
        unsigned long long seq;
        long long          stamp_ns;
        boolean            start;
        boolean            stop;
        boolean            planner;
        boolean            has_delta_heading;
        float              delta_heading;  // radians; valid iff has_delta_heading
    };

};
